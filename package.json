{
  "name": "wordball-react",
  "version": "2.0.0",
  "description": "Makers Final Project - Wordball React Game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "client": "pnpm --dir client dev",
    "dev": "concurrently \"node server.js\" \"pnpm --dir client dev\"",
    "build": "pnpm --dir client build",
    "test": "pnpm --dir client test",
    "typecheck": "pnpm --dir client typecheck",
    "install:all": "pnpm install && pnpm --dir client install"
  },
  "keywords": [
    "wordball",
    "react",
    "game",
    "makers"
  ],
  "author": "John Dennehy",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
