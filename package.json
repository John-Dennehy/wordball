{
  "name": "wordball-react",
  "version": "2.0.0",
  "description": "Makers Final Project - Wordball React Game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"node server.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "keywords": [
    "wordball",
    "react",
    "game",
    "makers"
  ],
  "author": "John Dennehy",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
